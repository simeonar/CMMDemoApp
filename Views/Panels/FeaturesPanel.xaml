<UserControl x:Class="CMMDemoApp.Views.Panels.FeaturesPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="Auto"/>
            <!-- für GridSplitter -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Oberer Teil -->
        <TreeView Grid.Row="0" Margin="4">
            <TreeViewItem Header="Assembly">
                <TreeViewItem Header="Part A"/>
                <TreeViewItem Header="Part B"/>
            </TreeViewItem>
        </TreeView>

        <!-- Trennzeichen -->
        <GridSplitter Grid.Row="1"
                      Height="4"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Center"
                      Background="#DDD"
                      ResizeDirection="Rows" />

        <!-- Unterer Teil -->
        <TabControl Grid.Row="2" Margin="4">
            <TabItem Header="Details">
                <TextBlock Text="Hier sind die Details zum Element" />
            </TabItem>
            <TabItem Header="Notizen">
                <TextBlock Text="Kommentare, Anmerkungen usw." />
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>

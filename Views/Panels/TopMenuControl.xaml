<UserControl
    x:Class="CMMDemoApp.Views.Panels.TopMenuControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:CMMDemoApp.Views.Panels"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <UserControl.Resources>
        <Style
            x:Key="TopMenuButtonStyle"
            BasedOn="{StaticResource {x:Static ToolBar.ButtonStyleKey}}"
            TargetType="Button">
            <Setter Property="Width" Value="70" />
            <Setter Property="Background" Value="#E5EDF7" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            Padding="4"
                            Background="{TemplateBinding Background}"
                            BorderThickness="0">
                            <StackPanel
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Orientation="Vertical">
                                <Image
                                    Width="24"
                                    Height="24"
                                    Margin="0,0,0,4"
                                    Source="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" />
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    TextAlignment="Center"
                                    TextWrapping="Wrap">
                                    <Run Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource FirstLineConverter}}" />
                                    <LineBreak />
                                    <Run Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource SecondLineConverter}}" />
                                    <LineBreak />
                                    <Run
                                        FontSize="10"
                                        Foreground="LightGray"
                                        Text="―" />
                                    <LineBreak />
                                    <Run Foreground="Gray" Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource FooterLineConverter}}" />
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <!--  2. TabControl über dem DockPanel  -->
        <TabControl
            Height="120"
            Padding="0"
            VerticalAlignment="Top"
            Panel.ZIndex="1"
            Background="AliceBlue"
            BorderThickness="0"
            TabStripPlacement="Top">
            <TabItem Margin="42,-0,-46,0" Header="Home">
                <Grid Background="#F0F0F0">
                    <!--  oder gleiche Farbe wie der Tab-Hintergrund  -->
                    <Border
                        Background="#F0F0F0"
                        BorderBrush="#D0D0D0"
                        BorderThickness="0,0,0,1">
                        <StackPanel Margin="0,0,0,0" Orientation="Horizontal">
                            <!--  Höhe des Panels  -->

                            <!--  Schaltfläche 1  -->
                            <Button
                                Width="70"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Stretch"
                                Background="#E5EDF7"
                                Click="LoadDesignButton_Click"
                                Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}">
                                <Grid VerticalAlignment="Stretch">
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Image
                                            Width="20"
                                            Height="20"
                                            Margin="0,0,0,5"
                                            Source="Resources/import_icon.png" />
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            TextAlignment="Center"
                                            TextWrapping="Wrap">
                                            <Run Text="Design" />
                                            <LineBreak />
                                            <Run Text="Model" />
                                            <LineBreak />
                                            <Run
                                                FontSize="10"
                                                Foreground="LightGray"
                                                Text="―" />
                                            <LineBreak />
                                            <Run Foreground="Gray" Text="Import" />
                                        </TextBlock>
                                    </StackPanel>
                                </Grid>
                            </Button>

                            <!--  Vertikaler Trenner  -->
                            <Separator
                                Width="1"
                                Margin="0,10"
                                Background="Gray" />

                            <!--  Schaltfläche 2  -->
                            <Button
                                Width="70"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Stretch"
                                Background="#E5EDF7"
                                Click="LoadDesignButton_Click"
                                Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}">
                                <Grid VerticalAlignment="Stretch">
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Image
                                            Width="20"
                                            Height="20"
                                            Margin="0,0,0,5"
                                            Source="Resources/import_icon.png" />
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            TextAlignment="Center"
                                            TextWrapping="Wrap">
                                            <Run Text="Design" />
                                            <LineBreak />
                                            <Run Text="Model" />
                                            <LineBreak />
                                            <Run
                                                FontSize="10"
                                                Foreground="LightGray"
                                                Text="―" />
                                            <LineBreak />
                                            <Run Foreground="Gray" Text="Import" />
                                        </TextBlock>
                                    </StackPanel>
                                </Grid>
                            </Button>
                            <!--<Button Content="Design Modell"
                                    Background="#E5EDF7"
                                    BorderThickness="0"
                                    Width="60"
                                    FontWeight="Bold"
                                    FontSize="10"
                                    Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}" Height="67" Click="LoadDesignButton_Click"/>-->

                            <Separator
                                Width="1"
                                Margin="0,10"
                                Background="Gray" />

                            <!--  Schaltfläche 3  -->
                            <Button
                                Width="70"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Stretch"
                                Background="#E5EDF7"
                                Click="LoadDesignButton_Click"
                                Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}">
                                <Grid VerticalAlignment="Stretch">
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Image
                                            Width="20"
                                            Height="20"
                                            Margin="0,0,0,5"
                                            Source="Resources/import_icon.png" />
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            TextAlignment="Center"
                                            TextWrapping="Wrap">
                                            <Run Text="Design" />
                                            <LineBreak />
                                            <Run Text="Model" />
                                            <LineBreak />
                                            <Run
                                                FontSize="10"
                                                Foreground="LightGray"
                                                Text="―" />
                                            <LineBreak />
                                            <Run Foreground="Gray" Text="Import" />
                                        </TextBlock>
                                    </StackPanel>
                                </Grid>
                            </Button>

                            <Separator
                                Width="1"
                                Margin="0,10"
                                Background="Gray" />

                            <!--  Schaltfläche 4  -->
                            <Button
                                Width="70"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Stretch"
                                Background="#E5EDF7"
                                Click="LoadDesignButton_Click"
                                Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}">
                                <Grid VerticalAlignment="Stretch">
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Image
                                            Width="20"
                                            Height="20"
                                            Margin="0,0,0,5"
                                            Source="Resources/import_icon.png" />
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            TextAlignment="Center"
                                            TextWrapping="Wrap">
                                            <Run Text="Design" />
                                            <LineBreak />
                                            <Run Text="Model" />
                                            <LineBreak />
                                            <Run
                                                FontSize="10"
                                                Foreground="LightGray"
                                                Text="―" />
                                            <LineBreak />
                                            <Run Foreground="Gray" Text="Import" />
                                        </TextBlock>
                                    </StackPanel>
                                </Grid>
                            </Button>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Margin="47,0,-52,0" Header="Ansicht">
                <StackPanel>
                    <CheckBox Content="Eigenschaften Ansicht" IsChecked="{Binding IsLeftPanelVisible}" />
                    <CheckBox Content="Linkes Panel" IsChecked="{Binding IsLeftPanelVisible, Mode=TwoWay}" />
                    <CheckBox Content="3D Splash anzeigen" IsChecked="{Binding IsSplashVisible, Mode=TwoWay}" />
                </StackPanel>
            </TabItem>
        </TabControl>

    </Grid>
</UserControl>

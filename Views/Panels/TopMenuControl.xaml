<UserControl x:Class="CMMDemoApp.Views.Panels.TopMenuControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:CMMDemoApp.Views.Panels"
             mc:Ignorable="d" >
<Grid>
        <!-- 2. TabControl über dem DockPanel -->
        <TabControl Panel.ZIndex="1"
                    Height="88"
                    TabStripPlacement="Top"
                    VerticalAlignment="Top"
                    Background="AliceBlue"
                    BorderThickness="0"
                    Padding="0">
            <TabItem Header="Home" Margin="42,-2,-46,1">
                <Grid Background="#F0F0F0">
                    <!-- oder gleiche Farbe wie der Tab-Hintergrund -->
                    <Border Background="#F0F0F0" BorderBrush="#D0D0D0" BorderThickness="0,0,0,1">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,0">
                            <!-- Höhe des Panels -->

                            <!-- Schaltfläche 1 -->
                            <Button Content="Regeln Editor"
                        Background="#E5EDF7"
                        BorderThickness="0"
                        Width="60"
                        FontWeight="Bold"
                        Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}" Height="66" HorizontalAlignment="Left"/>

                            <!-- Vertikaler Trenner -->
                            <Separator Width="1" Margin="0,10" Background="Gray"/>

                            <!-- Schaltfläche 2 -->
                            <Button Content="Design Modell"
                        Background="#E5EDF7"
                        BorderThickness="0"
                        Width="60"
                        FontWeight="Bold"
                        Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}" Height="67" Click="LoadDesignButton_Click"/>

                            <Separator Width="1" Margin="0,10" Background="Gray" />

                            <!-- Schaltfläche 3 -->
                            <Button Content="CRT-A5776-SP25"
                        Background="#E5EDF7"
                        BorderThickness="0"
                        Width="60"
                        FontWeight="Bold"
                        Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}" Height="66"/>

                            <Separator Width="1" Margin="0,10" Background="Gray" />

                            <!-- Schaltfläche 4 -->
                            <Button Content="Teil"
                        Background="#E5EDF7"
                        BorderThickness="0"
                        Width="60"
                        FontWeight="Bold"
                        Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}" Height="67"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="Ansicht" Margin="47,-2,-52,2">
                <StackPanel>
                    <CheckBox Content="Eigenschaften Ansicht" IsChecked="{Binding IsLeftPanelVisible}"/>
                    <CheckBox Content="Linkes Panel" IsChecked="{Binding IsLeftPanelVisible, Mode=TwoWay}" />
                    <CheckBox Content="3D Splash anzeigen"
          IsChecked="{Binding IsSplashVisible, Mode=TwoWay}" />
                </StackPanel>
            </TabItem>
        </TabControl>

    </Grid>
</UserControl>

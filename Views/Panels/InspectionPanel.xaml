<UserControl x:Class="CMMDemoApp.Views.Panels.InspectionPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:CMMDemoApp.Views.Panels"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <DockPanel Background="White">
        <!-- ToolBar oben -->
        <ToolBar DockPanel.Dock="Top">
            <Button Content="Alles auswählen"/>
            <Button Content="Aktualisieren"/>
        </ToolBar>

        <!-- Unterer TabControl -->
        <TabControl DockPanel.Dock="Bottom" Height="28">
            <TabItem Header="Baum"/>
            <TabItem Header="Flache Liste"/>
        </TabControl>

        <!-- Hauptinhalt -->
        <ListBox Margin="4">
            <ListBoxItem>94190 ▸ Ebenheit</ListBoxItem>
            <ListBoxItem>93630 ▸ Loch Ø10</ListBoxItem>
            <ListBoxItem>93103 ▸ Zylindrizität</ListBoxItem>
        </ListBox>
    </DockPanel>
</UserControl>

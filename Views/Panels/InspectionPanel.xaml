<UserControl x:Class="CMMDemoApp.Views.Panels.InspectionPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:CMMDemoApp.Views.Panels"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <DockPanel Background="White">
        <!-- ToolBar сверху -->
        <ToolBar DockPanel.Dock="Top">
            <Button Content="Select All"/>
            <Button Content="Refresh"/>
        </ToolBar>

        <!-- Нижний TabControl -->
        <TabControl DockPanel.Dock="Bottom" Height="28">
            <TabItem Header="Tree"/>
            <TabItem Header="Flat List"/>
        </TabControl>

        <!-- Основное содержимое -->
        <ListBox Margin="4">
            <ListBoxItem>94190 ▸ Flatness</ListBoxItem>
            <ListBoxItem>93630 ▸ Hole Ø10</ListBoxItem>
            <ListBoxItem>93103 ▸ Cylindricity</ListBoxItem>
        </ListBox>
    </DockPanel>
</UserControl>

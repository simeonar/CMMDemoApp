<Window x:Class="CMMDemoApp.Views.MainView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:conv="clr-namespace:CMMDemoApp.Converters"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MainView" Height="800" Width="1200">
    <Grid>
        <!-- 1. DockPanel на фоне (нижний слой) -->
        <DockPanel Opacity="0.9"
                   Height="86"
                   Background="AliceBlue"
                   VerticalAlignment="Top"
                   Panel.ZIndex="0">
            <!-- Можно добавить элементы, если нужно -->
        </DockPanel>

        <!-- 2. TabControl поверх DockPanel -->
        <TabControl Panel.ZIndex="1"
                    Height="88"
                    TabStripPlacement="Top"
                    VerticalAlignment="Top"
                    Background="AliceBlue"
                    BorderThickness="0"
                    Padding="0">
            <TabItem Header="Home" Margin="42,-2,-46,1">
                <Grid Background="#F0F0F0">
                    <!-- или цвет как у фона вкладки -->
                    <Border Background="#F0F0F0" BorderBrush="#D0D0D0" BorderThickness="0,0,0,1">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,0">
                            <!-- Высота панели -->

                            <!-- Кнопка 1 -->
                            <Button Content="Rules Editor"
                        Background="#E5EDF7"
                        BorderThickness="0"
                        Width="130"
                        FontWeight="Bold"
                        Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}" Height="66" HorizontalAlignment="Left"/>

                            <!-- Вертикальный разделитель -->
                            <Separator Width="1" Margin="0,10" Background="Gray"/>

                            <!-- Кнопка 2 -->
                            <Button Content="Design Model"
                        Background="#E5EDF7"
                        BorderThickness="0"
                        Width="130"
                        FontWeight="Bold"
                        Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}" Height="67"/>

                            <Separator Width="1" Margin="0,10" Background="Gray" />

                            <!-- Кнопка 3 -->
                            <Button Content="CRT-A5776-SP25"
                        Background="#E5EDF7"
                        BorderThickness="0"
                        Width="150"
                        FontWeight="Bold"
                        Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}" Height="66"/>

                            <Separator Width="1" Margin="0,10" Background="Gray" />

                            <!-- Кнопка 4 -->
                            <Button Content="Part"
                        Background="#E5EDF7"
                        BorderThickness="0"
                        Width="100"
                        FontWeight="Bold"
                        Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}" Height="67"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="View" Margin="47,-2,-52,2">
                <StackPanel>
                    <CheckBox Content="Properties View" IsChecked="{Binding IsLeftPanelVisible}"/>
                    <CheckBox Content="Left Panel" IsChecked="{Binding IsLeftPanelVisible, Mode=TwoWay}" />

                </StackPanel>
            </TabItem>
        </TabControl>

        <!-- 3. Кнопка поверх всего -->
        <Button Content="▼"
                Width="42"
                Height="24"
                Margin="0,-2,0,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Panel.ZIndex="2"
                Background="#2B579A"
                Foreground="White"
                FontWeight="Bold"
                BorderThickness="0"
                ContextMenuService.IsEnabled="True">
            <Button.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Open Project" />
                    <MenuItem Header="Import CAD" />
                    <Separator />
                    <MenuItem Header="Exit" />
                </ContextMenu>
            </Button.ContextMenu>
        </Button>

        <Border BorderBrush="Black" BorderThickness="1" Margin="0,92,0,0">
            <!-- 2. Основная рабочая область -->
            <Grid x:Name="MainLayout">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="32" />
                    <!-- Левая вкладочная панель -->
                    <ColumnDefinition Width="200" x:Name="LeftContentColumn"/>
                    <!-- Панель с контентом -->
                    <ColumnDefinition x:Name="CenterColumn" Width="*" />
                    <ColumnDefinition x:Name="RightColumn" Width="200"/>
                </Grid.ColumnDefinitions>
                <!-- 🧭 Вертикальные вкладки -->
                <ListBox x:Name="PanelSelector"
                         Grid.Column="0"
                         SelectionChanged="PanelSelector_SelectionChanged"
                         Background="#f0f0f0"
                         BorderThickness="0">
                    <ListBoxItem Tag="Features" Content="📄" ToolTip="Features" />
                    <ListBoxItem Tag="Rules" Content="🧩" ToolTip="Rules Editor" />
                    <ListBoxItem Tag="Inspection" Content="🛠" ToolTip="Inspection Setup" />
                </ListBox>

                <!-- 📄 Левая панель -->
                <!-- Левая панель: делим на 2 окна -->
                <ContentControl Grid.Column="1" Margin="0" ClipToBounds="True">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <!-- Верхняя часть -->
                            <RowDefinition Height="Auto" />
                            <!-- Разделитель -->
                            <RowDefinition Height="250" />
                            <!-- Нижняя часть (фиксированная или ресайз) -->
                        </Grid.RowDefinitions>

                        <!-- 🧱 Верхнее окно -->
                        <ContentControl Grid.Row="0" x:Name="LeftUpperPanel" />

                        <!-- ➖ Разделитель -->
                        <GridSplitter Grid.Row="1"
                                      Height="5"
                                      HorizontalAlignment="Stretch"
                                      VerticalAlignment="Center"
                                      Background="#DDD"
                                      ResizeDirection="Rows"
                                      ShowsPreview="True" />

                        <!-- 🧩 Нижнее окно -->
                        <ContentControl Grid.Row="2" x:Name="LeftLowerPanel" />
                    </Grid>
                </ContentControl>


                <GridSplitter Grid.Column="1"
                              Width="4"
                              HorizontalAlignment="Right"
                              VerticalAlignment="Stretch"
                              Background="#DDD"
                              ShowsPreview="True" />

                <!-- 🧊 Центр — 3D View -->
                <Border Grid.Column="2" Background="Black">
                    <TextBlock Text="3D Viewer"
                               Foreground="White"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontSize="20"/>
                    <!-- Тут может быть WebView2 / Babylon.js / HelixViewport3D -->
                </Border>

                <GridSplitter Grid.Column="2"
                              Width="4"
                              HorizontalAlignment="Right"
                              VerticalAlignment="Stretch"
                              Background="#DDD"
                              ShowsPreview="True" />

                <!-- 🧩 Правая панель -->
                <Border Grid.Column="3" 
                        Background="#F8F8F8" 
                        BorderBrush="#CCC" 
                        BorderThickness="1,0,0,0">
                    <ContentControl x:Name="RightPanelContent"
                                    ClipToBounds="True"
                                    Margin="0" />
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>

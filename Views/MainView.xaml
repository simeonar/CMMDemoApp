<Window x:Class="CMMDemoApp.Views.MainView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:conv="clr-namespace:CMMDemoApp.Converters"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:CMMDemoApp.Views.Panels" 
        Title="MainView" Height="800" Width="1200">
    <Window.Resources>
        <!--<conv:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>-->
        <DataTemplate x:Key="WebViewTemplate">
            <local:WebView />
        </DataTemplate>
        
    </Window.Resources>

    <Grid>
        <StatusBar Height="20"
                   VerticalAlignment="Bottom">
            <StatusBarItem>
                <TextBlock Text="Test"/>
            </StatusBarItem>
        </StatusBar>
        <!-- 1. DockPanel im Hintergrund (unterste Ebene) -->
        <DockPanel Opacity="0.9"
                   Height="86"
                   Background="AliceBlue"
                   VerticalAlignment="Top"
                   Panel.ZIndex="0">
            <local:TopMenuControl x:Name="TopMenu"/>
        </DockPanel>


        <!-- 3. Schaltfläche über allem -->
        <Button Content="▼"
                Width="42"
                Height="24"
                Margin="0,-2,0,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Panel.ZIndex="2"
                Background="#2B579A"
                Foreground="White"
                FontWeight="Bold"
                BorderThickness="0"
                ContextMenuService.IsEnabled="True">
            <Button.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Not implemented" />
                    <MenuItem Header="Not implemented" />
                    <Separator />
                    <MenuItem Header="Beenden" />
                </ContextMenu>
            </Button.ContextMenu>
        </Button>

        <Border BorderBrush="Black" BorderThickness="1" Margin="0,92,0,0">
            <!-- 2. Hauptarbeitsbereich -->
            <Grid x:Name="MainLayout">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="32" />
                    <!-- Linkes Tab-Panel -->
                    <ColumnDefinition Width="200" x:Name="LeftContentColumn"/>
                    <!-- Panel mit Inhalt -->
                    <ColumnDefinition x:Name="CenterColumn" Width="*" />
                    <!-- Rechtes Tab-Panel -->
                    <ColumnDefinition x:Name="RightColumn" Width="200"/>
                </Grid.ColumnDefinitions>
                <!-- 🧭 Vertikale Tabs -->
                <ListBox x:Name="PanelSelector"
                         Grid.Column="0"
                         SelectionChanged="PanelSelector_SelectionChanged"
                         Background="#f0f0f0"
                         BorderThickness="0">
                    <ListBoxItem Tag="Features" Content="📄" ToolTip="Features" />
                    <ListBoxItem Tag="Rules" Content="🧩" ToolTip="Regeln Editor" />
                    <ListBoxItem Tag="Inspection" Content="🛠" ToolTip="Inspektionssetup" />
                </ListBox>

                <!-- 📄 Linkes Panel -->
                <!-- Linkes Panel: in 2 Fenster aufteilen -->
                <ContentControl Grid.Column="1" Margin="0" ClipToBounds="True">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <!-- Oberer Bereich -->
                            <RowDefinition Height="Auto" />
                            <!-- Trenner -->
                            <RowDefinition Height="250" />
                            <!-- Unterer Bereich (fixiert oder veränderbar) -->
                        </Grid.RowDefinitions>

                        <!-- 🧱 Oberes Fenster -->
                        <ContentControl Grid.Row="0" x:Name="LeftUpperPanel" />

                        <!-- ➖ Trenner -->
                        <GridSplitter Grid.Row="1"
                                      Height="5"
                                      HorizontalAlignment="Stretch"
                                      VerticalAlignment="Center"
                                      Background="#DDD"
                                      ResizeDirection="Rows"
                                      ShowsPreview="True" />

                        <!-- 🧩 Unteres Fenster -->
                        <ContentControl Grid.Row="2" x:Name="LeftLowerPanel" />
                    </Grid>
                </ContentControl>


                <GridSplitter Grid.Column="1"
                              Width="4"
                              HorizontalAlignment="Right"
                              VerticalAlignment="Stretch"
                              Background="#DDD"
                              ShowsPreview="True" />

                <!-- 🧊 Mitte — 3D-Ansicht -->
                <Border Grid.Column="2">
                    <!--Visibility="{Binding IsWebViewVisible, Converter={StaticResource BooleanToVisibilityConverter}}"> -->
                    <TabControl x:Name="CenterTabControl" Grid.Column="2">
                        <TabItem Header="3D Заставка" x:Name="SplashTab">
                            <local:WebView />
                        </TabItem>
                    </TabControl>
                </Border>
                <GridSplitter Grid.Column="2"
                              Width="4"
                              HorizontalAlignment="Right"
                              VerticalAlignment="Stretch"
                              Background="#DDD"
                              ShowsPreview="True" />

                <!-- 🧩 Rechtes Panel -->
                <Border Grid.Column="3" 
                        Background="#F8F8F8" 
                        BorderBrush="#CCC" 
                        BorderThickness="1,0,0,0">
                    <ContentControl x:Name="RightPanelContent"
                                    ClipToBounds="True"
                                    Margin="0" />
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>